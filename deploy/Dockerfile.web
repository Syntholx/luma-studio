FROM node:24-bookworm-slim AS build
WORKDIR /source/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
RUN find /source/frontend/dist -type d -exec chmod 755 {} + && find /source/frontend/dist -type f -exec chmod 644 {} +

FROM caddy:2-alpine
COPY --from=build /source/frontend/dist/ /srv/
COPY deploy/Caddyfile /etc/caddy/Caddyfile
RUN chmod 644 /etc/caddy/Caddyfile
EXPOSE 8080
